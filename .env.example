# Firebase Configuration
# Copy this file to .env and fill in your actual values

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Portfolio chatbot (api/chat.js) — set in Vercel project settings (server-side, never VITE_-prefixed).
# Get a key from https://console.anthropic.com (pay-as-you-go; separate from a Claude Max subscription).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to claude-opus-4-8). For lower cost: claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8
